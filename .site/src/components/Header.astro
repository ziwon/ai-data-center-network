---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <button
      class="navigation-mode-toggle print:hidden"
      type="button"
      aria-label="Compact navigation"
      aria-pressed="false"
      title="Use compact navigation"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M9 4v16M6.5 10 4.5 12l2 2" />
      </svg>
    </button>
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      align-items: center;
      gap: 0.75rem;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .navigation-mode-toggle {
      display: none;
      place-items: center;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 0;
      color: var(--sl-color-gray-3);
      background: transparent;
      cursor: pointer;
    }

    .navigation-mode-toggle svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .navigation-mode-toggle:hover {
      border-color: var(--sl-color-gray-5);
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    .navigation-mode-toggle:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    .navigation-mode-toggle[aria-pressed='true'] {
      border-color: color-mix(in srgb, var(--sl-color-text-accent), transparent 55%);
      color: var(--sl-color-text-accent);
      background: color-mix(in srgb, var(--sl-color-text-accent), transparent 90%);
    }

    .navigation-mode-toggle[aria-pressed='true'] svg {
      transform: scaleX(-1);
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          minmax(
            calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
            auto
          )
          1fr
          auto;
        align-content: center;
      }

      .navigation-mode-toggle {
        display: grid;
      }
    }
  }
</style>
